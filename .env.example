# Публичные переменные (клиент + сервер)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=

# ID коллекций (совпадают со скриптом setupCollections по умолчанию)
NEXT_PUBLIC_DEPARTMENTS_COLLECTION_ID=departments
NEXT_PUBLIC_PROFILES_COLLECTION_ID=profiles
NEXT_PUBLIC_VKR_TOPICS_COLLECTION_ID=vkr_topics
NEXT_PUBLIC_TOPIC_AUDIT_COLLECTION_ID=topic_audit_log

# Сервер: ключ API с правами на Users + Databases (для API-маршрутов и скриптов)
APPWRITE_API_KEY=

# OpenAI — только на сервере (проверка похожих тем). Без NEXT_PUBLIC_!
# Локально: .env.local | Vercel: Settings → Environment Variables → Production → Redeploy
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_SIMILARITY_THRESHOLD=40
